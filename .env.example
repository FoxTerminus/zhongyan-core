# Load this explicitly; keep secrets out of Git.
SERVER_HOST=127.0.0.1
SERVER_PORT=8787
# Generate a long random value with the setup script before starting.
AGENT_AUTH_TOKEN=
AGENT_DATA_DIR=.data
AGENT_RUNTIME=disabled
# AGENT_RUNTIME=codex enables the isolated Codex adapter.
# Explicit auth selection. chatgpt-plan uses this app's separately authorized OSS profile.
# No automatic login, desktop credential import, or API-key fallback.
AGENT_CODEX_AUTH=codex-login
# AGENT_CHATGPT_PROFILE_DIR=.data/plan-profile
# Initial registration only; saved profiles retain their registered app identity.
AGENT_CHATGPT_APP_NAME=personal_agent
AGENT_APP_TITLE=终焉
# AGENT_CODEX_COMMAND=codex
# AGENT_CODEX_MODEL=choose-from-runtime-model-list
# Explicit opt-in only: experimental enables read-only tools for newly created conversations.
# Existing threads retain their original tools. This is not automatic memory or device access.
AGENT_CODEX_KNOWLEDGE_TOOLS=disabled
# Exact renderer origins; packaged desktop uses app://bundle. Android/iOS do not use CORS.
AGENT_ALLOWED_ORIGINS=app://bundle
