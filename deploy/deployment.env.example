# Public DNS hostname or IPv4, without scheme, path or port.
AGENT_DOMAIN=
# domain: ordinary hostname; ip: public IPv4 + Let's Encrypt short-lived cert.
AGENT_TLS_MODE=domain
# Native clients do not need CORS; Windows uses this exact packaged origin.
AGENT_ALLOWED_ORIGINS=app://bundle
RELEASE_TAG=local
# Reproducible compatibility baselines, configurable when upgrading.
NODE_IMAGE=node:24-bookworm-slim
CADDY_IMAGE=caddy:2.11.7-alpine
AGENT_CODEX_VERSION=0.154.0
# Empty selects the provider default; use an account-supported model when set.
AGENT_CODEX_MODEL=
AGENT_CHATGPT_APP_NAME=personal_agent
AGENT_APP_TITLE=Zhongyan

# Optional root-owned directory for host scheduler state, mounted read-only in server.
# Run prepare.mjs for the empty local default before starting Compose.
AGENT_OPERATIONS_STATE_DIR=./.operations-state
