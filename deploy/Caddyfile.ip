{
	http_port 8080
	https_port 8443
	admin off
	auto_https disable_redirects
	# Clients normally omit SNI for IP URLs. Select the public IP certificate,
	# not the Docker container's private address.
	default_sni {$AGENT_DOMAIN}
}

http://{$AGENT_DOMAIN} {
	redir https://{$AGENT_DOMAIN}{uri} permanent
}

https://{$AGENT_DOMAIN} {
	# An explicit public issuer prevents Caddy's default local CA for bare IPs.
	# Caddy renews automatically; /data must persist and 80/443 stay reachable.
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
		}
	}
	header {
		-Server
		X-Content-Type-Options nosniff
	}
	reverse_proxy server:8787 {
		flush_interval -1
	}
}
